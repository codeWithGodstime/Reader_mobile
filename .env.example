# Copy to .env for local development. Do not put real secrets in this file.
# Keep the documented Django origin. On Android the app rewrites loopback to
# http://10.0.2.2:8001 so the emulator can reach the host.
EXPO_PUBLIC_API_BASE_URL=http://127.0.0.1:8001
EXPO_PUBLIC_GOOGLE_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
